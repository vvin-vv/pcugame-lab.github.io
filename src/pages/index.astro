---
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getFeaturedActivities,
  getPageContent,
  getSiteContent,
  getMembers,
} from "../lib/content";
import {
  getLatestMemberPosition,
  sortPositionedMembers,
} from "../lib/member-sort";

const [siteContent, homeContent, research, projects, members] = await Promise.all([
  getSiteContent(),
  getPageContent("home"),
  getFeaturedActivities("research"),
  getFeaturedActivities("projects"),
  getMembers(),
]);
const currentMembers = sortPositionedMembers(
  members.map((member) => ({
    member,
    position: getLatestMemberPosition(member),
  })),
);
---

<BaseLayout>
  <Hero
    lines={homeContent.data.hero.lines}
    metaPrimary={homeContent.data.hero.metaPrimary}
    metaSecondary={homeContent.data.hero.metaSecondary}
    titleEn={homeContent.data.hero.titleEn}
    description={homeContent.data.hero.description}
    scrollLabel={homeContent.data.hero.scrollLabel}
  />

  <section class="intro section" id="introduction">
    <div class="container">
      <div class="intro__heading">
        <div class="intro__index">
          <span>{homeContent.data.intro.index}</span>
          <p class="eyebrow">{homeContent.data.intro.eyebrow}</p>
        </div>
        <h2>{siteContent.data.lab.statement}</h2>
      </div>

      <div class="intro__body">
        <div class="intro__monogram">
          <div
            class="intro__wordmark"
            aria-label={siteContent.data.wordmark.join(" ")}
          >
            {siteContent.data.wordmark.map((word) => <span>{word}</span>)}
          </div>
          <a class="text-link" href="/about/">
            {homeContent.data.intro.aboutLinkLabel}
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M2 10h15M11 4l6 6-6 6" fill="none" stroke="currentColor"></path>
            </svg>
          </a>
        </div>
        <dl class="intro__facts">
          {
            siteContent.data.lab.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="research section">
    <div class="container">
      <SectionHeading
        index={homeContent.data.research.index}
        eyebrow={homeContent.data.research.eyebrow}
        title={homeContent.data.research.title}
        description={homeContent.data.research.description}
      />
      {research.length === 0 && <p>{homeContent.data.research.emptyLabel}</p>}
      <div class="research__grid">
        {
          research.map((project, index) => (
            <ProjectCard project={project} index={index} />
          ))
        }
      </div>
      <div class="research__more">
        <a class="text-link" href="/research/">
          {homeContent.data.research.linkLabel}
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M2 10h15M11 4l6 6-6 6" fill="none" stroke="currentColor"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="research section">
    <div class="container">
      <SectionHeading {...homeContent.data.projects} />
      {projects.length === 0 && <p>{homeContent.data.projects.emptyLabel}</p>}
      <div class="research__grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
      <div class="research__more">
        <a class="text-link" href="/projects/">{homeContent.data.projects.linkLabel} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="method section section--dark">
    <div class="container">
      <SectionHeading
        index={homeContent.data.method.index}
        eyebrow={homeContent.data.method.eyebrow}
        title={homeContent.data.method.title}
        light
      />
      <ol class="method__list">
        {
          siteContent.data.lab.principles.map((principle, index) => (
            <li>
              <div class="method__number">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <i></i>
              </div>
              <div class="method__word">
                <span>{principle.label}</span>
                <h3>{principle.title}</h3>
              </div>
              <p>{principle.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="people section">
    <div class="container">
      <SectionHeading
        index={homeContent.data.people.index}
        eyebrow={homeContent.data.people.eyebrow}
        title={homeContent.data.people.title}
      />
      <div class="people__list">
        {
          currentMembers.map(({ member, position }, index) => (
            <a href={`/people/${member.id}/`} class="person-row">
              <span class="person-row__index">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span
                class:list={[
                  "person-row__avatar",
                  { "person-row__avatar--placeholder": !member.data.photo },
                ]}
                aria-hidden="true"
              >
                <img
                  src={member.data.photo ?? "/lcl-logo.svg"}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="person-row__name">
                <strong>{member.data.name}</strong>
                <small>{member.data.nameEn}</small>
              </span>
              <span class="person-row__role">{position.role}</span>
              <span class="person-row__arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))
        }
      </div>
      <div class="people__more">
        <a class="text-link" href="/people/">
          {homeContent.data.people.linkLabel}
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M2 10h15M11 4l6 6-6 6" fill="none" stroke="currentColor"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    background: var(--paper);
  }

  .intro__heading {
    display: grid;
    padding-bottom: clamp(4rem, 9vw, 9rem);
    grid-template-columns: minmax(12rem, 0.5fr) minmax(0, 1.5fr);
    gap: 3rem;
  }

  .intro__index {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .intro__index > span {
    color: var(--muted);
    font-size: 0.64rem;
    font-weight: 700;
  }

  .intro__heading h2 {
    max-width: 77rem;
    margin: 0;
    font-size: clamp(3rem, 7.5vw, 8.6rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.07em;
    word-break: keep-all;
  }

  .intro__body {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(17rem, 1.2fr);
    border-top: 1px solid var(--line);
  }

  .intro__monogram {
    display: flex;
    flex-direction: column;
    min-height: 31rem;
    padding: 2rem;
    justify-content: space-between;
    align-items: flex-start;
    gap: 3rem;
    color: var(--white);
    background: var(--ink);
    overflow: hidden;
  }

  .intro__wordmark {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    font-size: clamp(2.4rem, 4vw, 4.75rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.065em;
  }

  .intro__wordmark > span {
    display: block;
    flex: none;
    max-width: 100%;
    white-space: nowrap;
  }

  .intro__monogram .text-link {
    color: var(--white);
  }

  .intro__facts {
    margin: 0;
  }

  .intro__facts > div {
    padding: 1.5rem 0 2.5rem 2rem;
    border-bottom: 1px solid var(--line);
  }

  .intro__facts dt {
    margin-bottom: 1.2rem;
    color: var(--muted);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .intro__facts dd {
    margin: 0;
    font-size: clamp(1.05rem, 1.6vw, 1.4rem);
    line-height: 1.35;
  }

  .research {
    background: var(--white);
  }

  .research__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.3vw, 2.75rem);
  }

  .research__more,
  .people__more {
    display: flex;
    margin-top: clamp(3rem, 6vw, 6rem);
    justify-content: flex-end;
  }

  .method__list {
    border-top: 1px solid var(--line-dark);
  }

  .method__list li {
    display: grid;
    min-height: 16rem;
    padding-block: 2rem;
    align-items: center;
    grid-template-columns: minmax(5rem, 0.25fr) minmax(18rem, 0.85fr) minmax(
        18rem,
        0.9fr
      );
    gap: 2rem;
    border-bottom: 1px solid var(--line-dark);
  }

  .method__number {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: #777;
    font-size: 0.6rem;
    font-weight: 700;
  }

  .method__number i {
    width: 2.5rem;
    height: 1px;
    background: #444;
  }

  .method__word > span {
    color: #777;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .method__word h3 {
    margin: 0.2rem 0 0;
    font-size: clamp(3rem, 7vw, 7.5rem);
    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.07em;
  }

  .method__list li > p {
    max-width: 33rem;
    margin: 0;
    color: #aaa;
    font-size: clamp(0.95rem, 1.25vw, 1.15rem);
    line-height: 1.75;
    word-break: keep-all;
  }

  .people {
    background: var(--paper);
  }

  .people__list {
    border-top: 1px solid var(--line);
  }

  .person-row {
    display: grid;
    min-height: 10rem;
    padding-block: 1.5rem;
    align-items: center;
    grid-template-columns: 4rem 7rem minmax(12rem, 1fr) minmax(8rem, 0.5fr) 3rem;
    gap: 2rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .person-row__index {
    color: var(--muted);
    font-size: 0.6rem;
    font-weight: 700;
  }

  .person-row__avatar {
    display: grid;
    width: 5.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    color: var(--white);
    background: var(--ink);
    font-size: 0.8rem;
    font-weight: 700;
    place-items: center;
    overflow: hidden;
    transition: border-radius 500ms var(--ease-out);
  }

  .person-row__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person-row__avatar--placeholder img {
    width: 82%;
    height: 82%;
    object-fit: contain;
    opacity: 0.9;
    filter: invert(1);
  }

  .person-row__name {
    display: flex;
    flex-direction: column;
  }

  .person-row__name strong {
    font-size: clamp(2rem, 4vw, 4.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .person-row__name small,
  .person-row__role {
    color: var(--muted);
    font-size: 0.65rem;
    font-style: italic;
    letter-spacing: 0.04em;
  }

  .person-row__name small {
    margin-top: 0.45rem;
  }

  .person-row__role {
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .person-row__arrow {
    display: grid;
    width: 2.5rem;
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: 50%;
    place-items: center;
    transition:
      color 250ms ease,
      background 250ms ease,
      transform 350ms var(--ease-out);
  }

  .person-row:hover .person-row__avatar {
    border-radius: 0;
  }

  .person-row:hover .person-row__arrow {
    color: var(--white);
    background: var(--ink);
    transform: rotate(45deg);
  }

  @media (max-width: 64rem) {
    .research__grid {
      grid-template-columns: 1fr 1fr;
    }

    .research__grid > :global(:last-child) {
      grid-column: 1 / -1;
      width: calc(50% - 0.7rem);
    }
  }

  @media (max-width: 48rem) {
    .intro__heading {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .intro__body {
      grid-template-columns: 1fr;
    }

    .intro__monogram {
      min-height: 25rem;
    }

    .intro__wordmark {
      font-size: clamp(2.4rem, 11vw, 4.75rem);
    }

    .intro__facts {
      grid-column: 1;
      grid-template-columns: 1fr;
    }

    .intro__facts > div {
      padding-left: 0;
      border-right: 0;
    }

    .research__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .research__grid > :global(:last-child) {
      grid-column: auto;
      width: auto;
    }

    .method__list li {
      padding-block: 2.5rem;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .method__word h3 {
      font-size: 4rem;
    }

    .person-row {
      min-height: 8rem;
      grid-template-columns: 2rem 4.5rem 1fr 2.5rem;
      gap: 1rem;
    }

    .person-row__avatar {
      width: 4rem;
    }

    .person-row__role {
      display: none;
    }

    .person-row__name strong {
      font-size: 2rem;
    }
  }
</style>
