---
import { render } from "astro:content";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageContent, getSiteContent } from "../lib/content";

const [siteContent, aboutContent] = await Promise.all([
  getSiteContent(),
  getPageContent("about"),
]);
const { Content } = await render(aboutContent);
---

<BaseLayout
  title={aboutContent.data.seo.title}
  description={aboutContent.data.seo.description}
>
  <Hero
    lines={aboutContent.data.hero.lines}
    metaPrimary={aboutContent.data.hero.metaPrimary}
    metaSecondary={aboutContent.data.hero.metaSecondary}
    titleEn={aboutContent.data.hero.titleEn}
    description={aboutContent.data.hero.description}
  />

  <section class="manifesto section">
    <div class="container">
      <p class="manifesto__label">{aboutContent.data.manifestoLabel}</p>
      <p class="manifesto__statement">{siteContent.data.lab.statement}</p>
      <dl class="manifesto__facts">
        {
          siteContent.data.lab.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="about-copy section">
    <div class="about-copy__inner container">
      <aside>
        <span>{aboutContent.data.bodyMeta.index}</span>
        <p class="eyebrow">{aboutContent.data.bodyMeta.eyebrow}</p>
      </aside>
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  <section class="principles section section--dark">
    <div class="container">
      <SectionHeading
        index={aboutContent.data.principles.index}
        eyebrow={aboutContent.data.principles.eyebrow}
        title={aboutContent.data.principles.title}
        light
      />
      <div class="principles__grid">
        {
          siteContent.data.lab.principles.map((principle, index) => (
            <article>
              <div>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span>{principle.label}</span>
              </div>
              <h2>{principle.title}</h2>
              <p>{principle.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .manifesto {
    background: var(--white);
  }

  .manifesto__label {
    margin: 0 0 2rem;
    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .manifesto__statement {
    max-width: 90rem;
    margin: 0;
    font-size: clamp(3rem, 7.8vw, 9rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.07em;
    word-break: keep-all;
  }

  .manifesto__facts {
    display: grid;
    margin: clamp(5rem, 10vw, 10rem) 0 0;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }

  .manifesto__facts > div {
    padding: 1.5rem 1.5rem 0 0;
    border-right: 1px solid var(--line);
  }

  .manifesto__facts > div:not(:first-child) {
    padding-left: 1.5rem;
  }

  .manifesto__facts > div:last-child {
    border-right: 0;
  }

  .manifesto__facts dt {
    margin-bottom: 1.5rem;
    color: var(--muted);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .manifesto__facts dd {
    margin: 0;
    font-size: clamp(1rem, 1.7vw, 1.5rem);
    line-height: 1.35;
  }

  .about-copy {
    background: var(--paper);
  }

  .about-copy__inner {
    display: grid;
    grid-template-columns: minmax(12rem, 0.5fr) minmax(0, 1.5fr);
    gap: 3rem;
  }

  .about-copy aside {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 700;
  }

  .about-copy aside p {
    color: var(--ink);
  }

  .principles__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-dark);
    border-left: 1px solid var(--line-dark);
  }

  .principles article {
    display: flex;
    min-height: 34rem;
    padding: 1.75rem;
    flex-direction: column;
    border-right: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
  }

  .principles article > div {
    display: flex;
    justify-content: space-between;
    color: #777;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .principles h2 {
    margin: auto 0 1.5rem;
    font-size: clamp(3rem, 6vw, 7rem);
    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.07em;
  }

  .principles article > p {
    max-width: 25rem;
    margin: 0;
    color: #aaa;
    font-size: 0.95rem;
    line-height: 1.75;
    word-break: keep-all;
  }

  @media (max-width: 48rem) {
    .manifesto__facts {
      grid-template-columns: 1fr;
    }

    .manifesto__facts > div,
    .manifesto__facts > div:not(:first-child) {
      padding: 1.5rem 0 2rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .about-copy__inner {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .principles__grid {
      grid-template-columns: 1fr;
    }

    .principles article {
      min-height: 27rem;
    }
  }
</style>
