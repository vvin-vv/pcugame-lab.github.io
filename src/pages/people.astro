---
import { render } from "astro:content";
import MemberCard from "../components/MemberCard.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getMembers, getPageContent, getSiteContent } from "../lib/content";
import { sortPositionedMembers } from "../lib/member-sort";

const [members, { data: siteContent }, { data: content }] = await Promise.all([
  getMembers(),
  getSiteContent(),
  getPageContent("people"),
]);
const renderedMembers = await Promise.all(
  members.map(async (member) => ({
    member,
    Content: (await render(member)).Content,
  })),
);
const positionHistory = renderedMembers.flatMap(
  ({ member, Content }) =>
    member.data.positions.map((position) => ({
      member,
      Content,
      position,
    })),
);
const leadershipPositions = sortPositionedMembers(
  positionHistory.filter(
    ({ position }) => position.level === "leadership",
  ),
);
const memberPositions = sortPositionedMembers(
  positionHistory.filter(({ position }) => position.level === "member"),
);
const availableYears = [
  ...new Set(positionHistory.map(({ position }) => position.year)),
].sort((a, b) => b - a);
const initialYear = availableYears[0] ?? new Date().getFullYear();
const memberCountByYear = new Map(
  availableYears.map((year) => [
    year,
    positionHistory.filter(({ position }) => position.year === year).length,
  ]),
);
---

<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
>
  <Hero
    lines={content.hero.lines}
    metaPrimary={content.hero.metaPrimary}
    metaSecondary={content.hero.metaSecondary}
    titleEn={content.hero.titleEn}
    description={content.hero.description}
  />

  <section class="people-intro section--compact">
    <div class="container">
      <p class="eyebrow">{content.introEyebrow}</p>
      <p>
        {
          content.introLines.map((line, index) => (
            <>{index > 0 && <br />}{line}</>
          ))
        }
      </p>
    </div>
  </section>

  <section class="members">
    <div class="container">
      <div class="members__head">
        <div>
          <p class="eyebrow">{content.organizationEyebrow}</p>
          <h2>{content.organizationTitle}</h2>
        </div>
        <div
          class="year-switcher"
          role="group"
          aria-label={content.yearSelectorAriaLabel}
        >
          {
            availableYears.map((year, index) => (
              <button
                type="button"
                data-org-year={year}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span>{year}</span>
                <small>{memberCountByYear.get(year)}{content.yearCountSuffix}</small>
              </button>
            ))
          }
        </div>
      </div>

      <div
        class="org-chart"
        data-org-chart
        data-has-director={leadershipPositions.some(
          ({ position }) => position.year === initialYear,
        )}
        data-has-members={memberPositions.some(
          ({ position }) => position.year === initialYear,
        )}
      >
        <div class="org-chart__status" aria-live="polite">
          <span><strong data-org-active-year>{initialYear}</strong>{content.statusYearSuffix}</span>
          <span><strong data-org-count>{memberCountByYear.get(initialYear)}</strong>{content.statusCountSuffix}</span>
        </div>

        <p class="org-chart__level org-chart__level--leadership">
          {content.leadershipLabel}
        </p>
        <div class="org-chart__leadership">
          {
            leadershipPositions.map(
              ({ member, Content, position }) => (
                <div
                  class="org-chart__lead-node"
                  data-org-member
                  data-org-type="director"
                  data-org-year={position.year}
                  hidden={position.year !== initialYear}
                >
                  <MemberCard
                    member={member}
                    role={position.role}
                    group={position.group}
                  >
                    <Content />
                  </MemberCard>
                </div>
              ),
            )
          }
        </div>

        <p class="org-chart__level org-chart__level--members">
          {content.membersLabel}
        </p>
        <div class="org-chart__members">
          {
            memberPositions.map(
              ({ member, Content, position }) => (
                <div
                  class="org-chart__member-node"
                  data-org-member
                  data-org-type="member"
                  data-org-year={position.year}
                  hidden={position.year !== initialYear}
                >
                  <MemberCard
                    member={member}
                    role={position.role}
                    group={position.group}
                  >
                    <Content />
                  </MemberCard>
                </div>
              ),
            )
          }
        </div>

        <p class="org-chart__empty" data-org-empty hidden>
          {content.emptyLabel}
        </p>
      </div>
    </div>
  </section>

  <section class="join section section--dark">
    <div class="container">
      <span>{content.joinEyebrow}</span>
      <h2>
        {
          content.joinTitleLines.map((line, index) => (
            <>{index > 0 && <br />}{line}</>
          ))
        }
      </h2>
      <a class="text-link" href={siteContent.site.github} target="_blank" rel="noreferrer">
        {content.joinLinkLabel}
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M2 10h15M11 4l6 6-6 6" fill="none" stroke="currentColor"></path>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .people-intro {
    background: var(--paper);
  }

  .people-intro .container {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
  }

  .people-intro .container > p:last-child {
    max-width: 62rem;
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 6.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.065em;
    word-break: keep-all;
  }

  .members {
    /* 카드 폭 고정 - 뷰포트가 변해도 카드 크기/폰트/배치가 동일해야 함 */
    --card-width: 400px;
    --org-gap: clamp(0.75rem, 1.25vw, 1.5rem);
    padding-top: clamp(2rem, 5vw, 5rem);
    padding-bottom: clamp(5rem, 10vw, 10rem);
    background: var(--paper);
  }

  .members__head {
    display: flex;
    padding-top: 1.5rem;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--line);
  }

  .members__head h2 {
    margin: 1.5rem 0 0;
    font-size: clamp(2.5rem, 5vw, 5.5rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.065em;
  }

  .year-switcher {
    display: flex;
    max-width: 60%;
    align-items: stretch;
    border: 1px solid var(--line);
    background: var(--white);
    overflow-x: auto;
  }

  .year-switcher button {
    display: flex;
    min-width: 7rem;
    padding: 0.85rem 1rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 0;
    border-right: 1px solid var(--line);
    color: var(--muted);
    background: transparent;
    cursor: pointer;
    font: inherit;
  }

  .year-switcher button:last-child {
    border-right: 0;
  }

  .year-switcher button[aria-pressed="true"] {
    color: var(--white);
    background: var(--ink);
  }

  .year-switcher button span {
    font-size: 0.78rem;
    font-weight: 700;
  }

  .year-switcher button small {
    color: #888;
    font-size: 0.55rem;
    font-weight: 700;
  }

  .org-chart {
    margin-top: clamp(4rem, 8vw, 8rem);
  }

  .org-chart__status {
    display: flex;
    margin-bottom: clamp(3rem, 5vw, 5rem);
    align-items: center;
    justify-content: space-between;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .org-chart__status span:last-child {
    display: inline-flex;
    width: 3rem;
    aspect-ratio: 1;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--white);
    background: var(--ink);
  }

  .org-chart__level {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .org-chart__level--members {
    margin-top: clamp(4.5rem, 7vw, 7rem);
  }

  .org-chart__leadership {
    display: flex;
    justify-content: center;
    gap: var(--org-gap);
  }

  .org-chart__lead-node {
    width: var(--card-width);
  }

  .org-chart__members {
    display: grid;
    justify-content: center;
    grid-template-columns: repeat(auto-fill, var(--card-width));
    align-items: stretch;
    gap: var(--org-gap);
  }

  .org-chart__member-node {
    position: relative;
  }

  .org-chart__empty {
    margin: 4rem 0 0;
    padding: 4rem 1rem;
    border: 1px dashed var(--line);
    color: var(--muted);
    text-align: center;
  }

  .org-chart[data-has-director="false"] .org-chart__level--leadership,
  .org-chart[data-has-director="false"] .org-chart__leadership,
  .org-chart[data-has-members="false"] .org-chart__level--members,
  .org-chart[data-has-members="false"] .org-chart__members {
    display: none;
  }

  .join .container {
    position: relative;
  }

  .join span {
    color: #777;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .join h2 {
    margin: clamp(3rem, 6vw, 6rem) 0;
    font-size: clamp(3.5rem, 9vw, 10rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.075em;
  }

  .join .text-link {
    color: var(--white);
  }

  @media (max-width: 48rem) {
    .people-intro .container {
      grid-template-columns: 1fr;
    }

    .members__head {
      align-items: stretch;
      flex-direction: column;
    }

    .year-switcher {
      width: 100%;
      max-width: none;
      overflow-x: auto;
    }

    .year-switcher button {
      min-width: 6.5rem;
      flex: 1 0 auto;
    }

    .org-chart__leadership {
      display: flex;
    }

    .org-chart__lead-node {
      width: 100%;
    }

    .org-chart__members {
      grid-template-columns: 1fr;
    }

    .members {
      --card-width: 100%;
    }

    .org-chart__member-node + .org-chart__member-node {
      margin-top: 1rem;
    }
  }


</style>

<script>
  const chart = document.querySelector<HTMLElement>("[data-org-chart]");
  const yearButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-org-year]"),
  );

  if (chart && yearButtons.length > 0) {
    const memberNodes = Array.from(
      chart.querySelectorAll<HTMLElement>("[data-org-member]"),
    );
    const activeYear = chart.querySelector<HTMLElement>(
      "[data-org-active-year]",
    );
    const activeCount = chart.querySelector<HTMLElement>("[data-org-count]");
    const emptyState = chart.querySelector<HTMLElement>("[data-org-empty]");

    const showYear = (year: string, updateUrl = false) => {
      let count = 0;
      let directorCount = 0;
      let memberCount = 0;

      memberNodes.forEach((node) => {
        const isVisible = node.dataset.orgYear === year;
        node.hidden = !isVisible;

        if (isVisible) {
          count += 1;
          if (node.dataset.orgType === "director") directorCount += 1;
          if (node.dataset.orgType === "member") memberCount += 1;
        }
      });

      yearButtons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.orgYear === year),
        );
      });

      chart.dataset.hasDirector = String(directorCount > 0);
      chart.dataset.hasMembers = String(memberCount > 0);
      if (activeYear) activeYear.textContent = year;
      if (activeCount) activeCount.textContent = String(count);
      if (emptyState) emptyState.hidden = count > 0;

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set("year", year);
        window.history.replaceState({}, "", url);
      }
    };

    yearButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (button.dataset.orgYear) showYear(button.dataset.orgYear, true);
      });
    });

    const requestedYear = new URLSearchParams(window.location.search).get(
      "year",
    );
    const initialButton = yearButtons.find(
      (button) => button.dataset.orgYear === requestedYear,
    );
    showYear(
      initialButton?.dataset.orgYear ?? yearButtons[0].dataset.orgYear ?? "",
    );
  }
</script>
