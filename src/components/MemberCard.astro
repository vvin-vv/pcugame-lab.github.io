---
import type { CollectionEntry } from "astro:content";
import { getPageContent, getSiteContent } from "../lib/content";

interface Props {
  member: CollectionEntry<"members">;
  role: string;
  group: string;
}

const { member, role, group } = Astro.props;
const [{ data: siteContent }, { data: peopleContent }] = await Promise.all([
  getSiteContent(),
  getPageContent("people"),
]);
const { data } = member;
const hasPhoto = Boolean(data.photo);
// 카드는 요약이므로 앞의 2개만 보이고 나머지는 +N으로 접습니다.
const INTEREST_LIMIT = 2;
const visibleInterests = data.interests.slice(0, INTEREST_LIMIT);
const hiddenInterestCount = data.interests.length - visibleInterests.length;
---

<article class="member-card">
  <div
    class:list={[
      "member-card__visual",
      { "member-card__visual--placeholder": !hasPhoto },
    ]}
    aria-hidden="true"
  >
    <img
      src={data.photo ?? "/lcl-logo.svg"}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="member-card__info">
    <div class="member-card__role">
      <span>{role}</span>
      <span>{group}</span>
    </div>
    <div class="member-card__identity">
      <h2><a class="member-profile-link" href={`/people/${member.id}/`}>{data.name}</a></h2>
      <p class="member-card__name-en">{data.nameEn}</p>
    </div>
    <div class="member-card__bio">
      <slot />
    </div>
    {
      data.interests.length > 0 && (
        <ul
          class="member-card__interests"
          aria-label={siteContent.accessibility.memberInterestsLabel}
        >
          {visibleInterests.map((interest) => <li>{interest}</li>)}
          {
            hiddenInterestCount > 0 && (
              <li
                class="member-card__interests-more"
                title={siteContent.accessibility.memberInterestsMoreLabel.replace(
                  "{count}",
                  String(hiddenInterestCount),
                )}
              >
                +{hiddenInterestCount}
              </li>
            )
          }
        </ul>
      )
    }
    {
      (data.github || data.website || data.email) && (
        <div class="member-card__links">
          {data.github && (
            <a href={data.github} target="_blank" rel="noreferrer">
              {peopleContent.memberLinks.github} <span>↗</span>
            </a>
          )}
          {data.website && (
            <a href={data.website} target="_blank" rel="noreferrer">
              {peopleContent.memberLinks.website} <span>↗</span>
            </a>
          )}
          {data.email && (
            <a href={`mailto:${data.email}`}>
              {peopleContent.memberLinks.email} <span>↗</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  .member-profile-link { color: inherit; text-decoration: none; }
  .member-profile-link:hover { text-decoration: underline; }
  .member-card {
    --photo-width: 38%;
    display: flex;
    min-width: 0;
    /* 카드 높이 = 사진 높이. 사진은 폭 38%의 3:4 -> 카드폭 * 0.38 * 4/3 */
    aspect-ratio: 1 / 0.50667;
    box-sizing: content-box;
    flex-direction: row;
    border: 1px solid var(--line);
    background: var(--white);
  }

  .member-card__visual {
    position: relative;
    display: grid;
    flex: 0 0 var(--photo-width);
    color: var(--white);
    background: var(--ink);
    place-items: center;
    overflow: hidden;
  }

  /* 사진과 정보 영역의 경계. img 위에 얹어야 보이고, 폭에 안 잡혀 3:4 유지 */
  .member-card__visual::after {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
    content: "";
  }

  .member-card__visual > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .member-card__visual--placeholder > img {
    width: min(52%, 14rem);
    height: auto;
    opacity: 0.88;
    filter: invert(1);
  }

  .member-card__info {
    display: grid;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    padding: 0.475rem 14px;
    flex: 1;
    /* 1:role/group 2:name 3:bio 4:interests 5:links — 균등 5행 */
    grid-template-rows: repeat(5, minmax(0, 1fr));
    align-items: center;
    background: var(--white);
  }

  .member-card__role {
    grid-row: 1;
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.525rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .member-card__identity {
    grid-row: 2;
    display: flex;
    min-width: 0;
    max-height: 100%;
    align-items: baseline;
    gap: 0.4rem;
    overflow: hidden;
  }

  h2 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.075em;
  }

  .member-card__name-en {
    margin: 0;
    color: var(--muted);
    font-size: 0.625rem;
    font-style: italic;
  }

  .member-card__bio {
    grid-row: 3;
    display: -webkit-box;
    min-height: 0;
    -webkit-box-orient: vertical;
    /* ponytail: 5등분 1행에는 1줄만 들어감 */
    -webkit-line-clamp: 1;
    overflow: hidden;
    color: #484844;
    font-size: 0.725rem;
    line-height: 1.5;
    word-break: keep-all;
  }

  .member-card__bio :global(p) {
    margin: 0;
  }

  .member-card__interests {
    grid-row: 4;
    display: flex;
    margin-left: -2px;
    min-width: 0;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0.28rem;
  }

  .member-card__interests li {
    min-width: 0;
    padding: 0.275rem 0.45rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .member-card__interests-more {
    flex: none;
    border-color: transparent;
    color: var(--muted);
  }

  .member-card__links {
    grid-row: 5;
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: nowrap;
    overflow: hidden;
  }

  .member-card__links a {
    display: inline-flex;
    padding-bottom: 0.2rem;
    gap: 0.5rem;
    border-bottom: 1px solid var(--ink);
    font-size: 0.5875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .member-card__links a span {
    transition: transform 250ms ease;
  }

  .member-card__links a:hover span {
    transform: rotate(45deg);
  }

  @media (max-width: 48rem) {
    .member-card {
      height: 100%;
      aspect-ratio: auto;
      flex-direction: column;
    }

    /* 세로 카드는 폭이 넓어 cqw가 과해짐 -> 고정 크기로 복귀 */
    .member-card__info {
      padding: clamp(1.25rem, 1.8vw, 2rem);
    }

    .member-card__role {
      font-size: 0.54rem;
    }

    h2 {
      font-size: clamp(2.1rem, 3.2vw, 3.75rem);
    }

    .member-card__name-en {
      font-size: 0.72rem;
    }

    .member-card__bio {
      font-size: 0.88rem;
    }

    .member-card__interests li {
      padding: 0.4rem 0.55rem;
      font-size: 0.5rem;
    }

    .member-card__links a {
      font-size: 0.6rem;
    }

    .member-card__visual {
      flex: none;
      aspect-ratio: 16 / 10;
    }

    .member-card__visual:not(.member-card__visual--placeholder) {
      background: #000;
    }

    .member-card__visual:not(.member-card__visual--placeholder) > img {
      position: absolute;
      inset: 0;
      object-fit: contain;
    }

    /* 세로 카드에서는 5행 고정 해제 */
    .member-card__info {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .member-card__role,
    .member-card__identity,
    .member-card__bio,
    .member-card__interests,
    .member-card__links {
      grid-row: auto;
    }

    .member-card__bio {
      -webkit-line-clamp: none;
    }

    .member-card__interests {
      flex-wrap: wrap;
    }

    .member-card__links {
      margin-top: auto;
      padding-top: 1rem;
      flex-wrap: wrap;
    }

    h2 {
      margin-top: 2.5rem;
    }
  }
</style>
