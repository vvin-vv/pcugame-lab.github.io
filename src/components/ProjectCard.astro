---
import type { Activity } from "../lib/content";
import ActivityParticipants from "./ActivityParticipants.astro";
import { getSiteContent } from "../lib/content";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: Activity;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const { data: content } = await getSiteContent();
const { data } = project;
---

<article class="project-card">
  <a
    href={`/${project.collection}/${project.id}/`}
    aria-label={`${data.title} ${project.collection === "research" ? content.accessibility.researchViewSuffix : content.accessibility.projectViewSuffix}`}
  >
    <div class="project-card__meta">
      <span>{String(index + 1).padStart(2, "0")}</span>
      <span>{data.code}</span>
      <span>{data.phase}</span>
    </div>
    <ProjectVisual visual={data.visual} label={data.code} />
    <div class="project-card__body">
      <p>{data.titleEn}</p>
      <h3>{data.title}</h3>
      <p class="project-card__summary">{data.summary}</p>
      <ul aria-label={project.collection === "research" ? content.accessibility.researchKeywordsLabel : content.accessibility.projectKeywordsLabel}>
        {data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
      <span class="project-card__arrow" aria-hidden="true">↗</span>
    </div>
  </a>
  <ActivityParticipants participants={project.participants} />
</article>

<style>
  .project-card {
    min-width: 0;
  }

  a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .project-card__meta {
    display: grid;
    padding-block: 0.85rem;
    grid-template-columns: 1fr auto auto;
    gap: 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-card__body {
    position: relative;
    padding: 1.7rem 3rem 1rem 0;
  }

  .project-card__body > p:first-child {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.68rem;
    font-style: italic;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.75rem, 2.5vw, 2.75rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.055em;
    word-break: keep-all;
  }

  .project-card__summary {
    margin: 1.25rem 0 1.5rem;
    color: #555550;
    font-size: 0.9rem;
    line-height: 1.7;
    word-break: keep-all;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  li {
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-card__arrow {
    position: absolute;
    top: 1.7rem;
    right: 0;
    display: grid;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    place-items: center;
    transition:
      color 250ms ease,
      background 250ms ease,
      transform 350ms var(--ease-out);
  }

  a:hover .project-card__arrow {
    color: var(--white);
    background: var(--ink);
    transform: rotate(45deg);
  }

  @media (max-width: 48rem) {
    .project-card__body {
      padding-top: 1.4rem;
    }
  }
</style>
