{
  "name": "ludic-core-laboratory",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:hooks": "git config core.hooksPath .githooks",
    "content:check": "node scripts/validate-content.mjs",
    "check": "npm run content:check && astro check",
    "validate": "npm run test && npm run check && npm run build && npm run site:check",
    "test": "node --test tests/*.test.mjs",
    "site:check": "node scripts/check-built-site.mjs"
  },
  "dependencies": {
    "astro": "^7.1.3",
    "pretendard": "^1.3.9",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "parse5": "^8.0.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  }
}
